      "missed": [
        {
          "expected_id": "p01-f1",
          "location": "src/uploader.py:35-37",
          "issue_type": "ErrorHandling",
          "description": "Returning `None` after exhausting the retries converts a reported failure into a silent one. `upload_all` appends the `None` straight into `receipts`, and `build_manifest` in src/manifest.py dereferences `r.etag` for every receipt, so a permanently failing chunk raises `AttributeError: 'NoneType' object has no attribute 'etag'` far from the upload that actually failed. The bare `except Exception` also captures the exception into `last` and then discards it, so the original transport error is lost."
        }
      ],
      "withheld": 0
