      },
      "matched": [],
      "unmatched_predictions": [],
      "missed": [
        {
          "expected_id": "n02-f1",
          "location": "src/pipeline.rs:56",
          "issue_type": "Correctness",
          "description": "`Counters::accepted()` is a destructive read: it swaps the tally back to zero as it returns it. Filling the summary from it makes `finish_batch` a second consumer of a counter that is documented to have exactly one legitimate reader, so every accepted record consumed here is deducted from the next metrics scrape. `telemetry::sample` then reports `accepted: 0` for records that were really accepted, while `rejected` -- which `finish_batch` does not read -- still reports correctly, so the metrics endpoint silently under-counts accepted throughput by exactly the number of records each batch summary claimed."
        }
      ],
      "withheld": 1
    },
