# Verified Code Reviewer — configuration template.
#
# Copy this file to `.env` and fill in the marked values.
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Provider
# ---------------------------------------------------------------------------

# `vertex` (default) or `mock`. `mock` is the offline stub used by --dry-run;
# it produces no measurements.
VCR_PROVIDER=vertex

# ---------------------------------------------------------------------------
# Google Vertex AI
# ---------------------------------------------------------------------------

# REQUIRED. The publisher model id exactly as Vertex expects it.
VERTEX_MODEL=gemini-3.7-flash

# REQUIRED for `access_token` and `gcloud` auth; also required to build the
# endpoint URL. Your Google Cloud project id.
VERTEX_PROJECT_ID=

# Vertex region, or `global`. Must be a region where the model is served.
VERTEX_LOCATION=global

# How to authenticate. One of:
#
#   api_key       Sends VERTEX_API_KEY in the `x-goog-api-key` header.
#   access_token  Sends VERTEX_ACCESS_TOKEN as a bearer token.
#   gcloud        Runs `gcloud auth print-access-token` at startup.
#                 Requires the gcloud CLI on PATH and an active login.
VERTEX_AUTH=api_key

# ---> PUT YOUR CREDENTIAL HERE <---
#
# Fill in exactly ONE of the following, matching VERTEX_AUTH above.
# Leave the others empty. Neither value is ever written to a trajectory.

# For VERTEX_AUTH=api_key
VERTEX_API_KEY=

# For VERTEX_AUTH=access_token
# Obtain with: gcloud auth print-access-token
# These are short-lived (about an hour) and need refreshing between runs.
VERTEX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Cost accounting
# ---------------------------------------------------------------------------
#
# Token prices in USD per million tokens, from the provider's published rates.
#
# Deliberately blank. Cost per case is a reported metric, and the project does
# not invent numbers: leave these unset and cost is reported as "unavailable"
# rather than as a guess. Set BOTH or NEITHER — half-configured pricing is
# rejected at startup.

VCR_PRICE_INPUT_USD_PER_MTOK=
VCR_PRICE_OUTPUT_USD_PER_MTOK=

# ---------------------------------------------------------------------------
# Model request settings
# ---------------------------------------------------------------------------

# 0.0 keeps runs as repeatable as the provider allows. Both arms use the same
# value; changing it invalidates the comparison.
VCR_TEMPERATURE=0.0
VCR_MAX_OUTPUT_TOKENS=8192
VCR_TIMEOUT_SECS=180

# Retries on timeouts, 429s, 5xx, and unparseable responses.
VCR_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Evaluation and tool limits
# ---------------------------------------------------------------------------

# Line-range slack when matching a prediction to ground truth. Part of the
# frozen evaluation contract: changing it after the benchmark freeze requires
# rerunning every experiment.
VCR_MATCH_LINE_TOLERANCE=3

# Investigation budget per candidate finding.
VCR_MAX_TOOL_CALLS_PER_FINDING=8
VCR_MAX_READ_LINES=200
VCR_MAX_SEARCH_RESULTS=40
